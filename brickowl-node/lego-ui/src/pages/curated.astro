---
import { curatedPieces } from "../data/curated-pieces";
import Layout from "../layouts/Layout.astro";
import type { Category, CuratedPieces, Piece } from "../types/curated";

// Calculate category totals
const categoryTotals = Object.entries(
    curatedPieces.categories as CuratedPieces["categories"],
).map(([name, category]: [string, Category]) => ({
    name,
    total: category.pieces.reduce(
        (sum: number, piece: Piece) => sum + piece.qty,
        0,
    ),
}));
---

<Layout title="Curated LEGO Pieces">
    <main class="container mx-auto px-4 py-8">
        <!-- Metadata Section -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
            <h1 class="text-3xl font-bold mb-4">Curated LEGO Collection</h1>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-blue-50 p-4 rounded-lg">
                    <h2 class="text-lg font-semibold text-blue-800">
                        Age Range
                    </h2>
                    <p class="text-2xl font-bold text-blue-900">
                        {curatedPieces.metadata.targetAgeRange}
                    </p>
                </div>
                <div class="bg-green-50 p-4 rounded-lg">
                    <h2 class="text-lg font-semibold text-green-800">
                        Total Pieces
                    </h2>
                    <p class="text-2xl font-bold text-green-900">
                        {curatedPieces.metadata.totalPieces}
                    </p>
                </div>
                <div class="bg-purple-50 p-4 rounded-lg">
                    <h2 class="text-lg font-semibold text-purple-800">
                        Last Updated
                    </h2>
                    <p class="text-2xl font-bold text-purple-900">
                        {curatedPieces.metadata.lastUpdated}
                    </p>
                </div>
            </div>
        </div>

        <!-- Category Distribution -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-8">
            <h2 class="text-2xl font-bold mb-4">Category Distribution</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {
                    categoryTotals.map(
                        (category: { name: string; total: number }) => (
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <h3 class="text-lg font-semibold text-gray-800 capitalize">
                                    {category.name
                                        .replace(/([A-Z])/g, " $1")
                                        .trim()}
                                </h3>
                                <p class="text-2xl font-bold text-gray-900">
                                    {category.total} pieces
                                </p>
                            </div>
                        ),
                    )
                }
            </div>
        </div>

        <!-- Categories -->
        {
            Object.entries(
                curatedPieces.categories as CuratedPieces["categories"],
            ).map(([categoryName, category]: [string, Category]) => (
                <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                    <h2 class="text-2xl font-bold mb-2 capitalize">
                        {categoryName.replace(/([A-Z])/g, " $1").trim()}
                    </h2>
                    <p class="text-gray-600 mb-6">{category.description}</p>

                    <div class="overflow-x-auto">
                        <table class="min-w-full table-auto">
                            <thead>
                                <tr class="bg-gray-50">
                                    <th class="px-4 py-2 text-left">Piece</th>
                                    <th class="px-4 py-2 text-left">Type</th>
                                    <th class="px-4 py-2 text-left">Image</th>
                                    <th class="px-4 py-2 text-center">
                                        Quantity
                                    </th>
                                    <th class="px-4 py-2 text-left">
                                        Reasoning
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {category.pieces.map(
                                    (piece: Piece, index: number) => (
                                        <tr
                                            class={
                                                index % 2 === 0
                                                    ? "bg-white"
                                                    : "bg-gray-50"
                                            }
                                        >
                                            <td class="px-4 py-2 font-medium">
                                                {piece.pieceTitle}
                                            </td>
                                            <td class="px-4 py-2">
                                                {piece.type}
                                            </td>
                                            <td class="px-4 py-2">
                                                <img
                                                    src={piece.img}
                                                    alt={piece.pieceTitle}
                                                    width="120"
                                                    class="rounded-lg shadow-sm"
                                                />
                                            </td>
                                            <td class="px-4 py-2 text-center">
                                                {piece.qty}
                                            </td>
                                            <td class="px-4 py-2 text-gray-600">
                                                {piece.reasoning}
                                            </td>
                                        </tr>
                                    ),
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            ))
        }
    </main>
</Layout>

<style>
    .container {
        max-width: 1200px;
    }
    table {
        border-collapse: separate;
        border-spacing: 0;
    }
    th,
    td {
        border-bottom: 1px solid #e2e8f0;
    }
    th {
        font-weight: 600;
    }
</style>
